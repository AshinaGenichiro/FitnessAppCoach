<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.NewPage2"
             Title="NewPage2">
    <ContentPage.Resources>
        <Style x:Key="InformationBorderStyle" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="InformationLabel" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout Spacing="10" Padding="10">
        <Label 
            Text="Workout Plan"
            FontSize="18"
            FontAttributes="Bold"
            HorizontalOptions="Center" />
        <Label 
            Text="My weight loss plan"
            FontSize="16"
            TextColor="#4CD964"
            HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
            <Label Text="By AI coach"
                   TextColor="#666666"
                   VerticalOptions="Center"
                   FontSize="12"/>
            <Border BackgroundColor="#8A2BE2" Style="{StaticResource InformationBorderStyle}">
                <Label Text="👤 Slim Seeker" Style="{StaticResource InformationLabel}"/>
            </Border>
        </HorizontalStackLayout>
        <Border
            WidthRequest="600"
            StrokeShape="RoundRectangle 15"
            Stroke="#E0E0E0"
            BackgroundColor="#F8F9FA"
            Padding="16">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="ℹ️ " FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Plan Overview" FontFamily="Bold" FontSize="14" TextColor="Black" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="˄" FontSize="14" TextColor="Black" VerticalOptions="Center"/>
                </Grid>
                <Label Text="This beginner-friendly workout plan aims to help you lose weight by incorporating a mix of gym and home exercises. Focusing on a full-body approach, the plan encourages steady fat burning and increases your overall fitness level."
                       TextColor="#555555"
                       FontSize="12"/>
            </VerticalStackLayout>
        </Border>
        <Label 
            Text="Select a Workout"
            FontSize="16"
            FontAttributes="Bold"
            Margin="0,10,0,0"/>
        <Border
            WidthRequest="600"
            StrokeShape="RoundRectangle 20"
            Stroke="Transparent"
            BackgroundColor="#E6D9FF"
            Padding="16">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Full Body Blast"
                            FontSize="18"
                            TextColor="Black"
                            FontAttributes="Bold"/>
                        <Label
                            Text="Full body"
                            FontSize="12"
                            TextColor="#444444"/>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="🆕" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="You haven't done this yet"
                               TextColor="#555555"
                               FontSize="11"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <Border BackgroundColor="#824cd4" Style="{StaticResource InformationBorderStyle}">
                            <Label Text="5 exercises" Style="{StaticResource InformationLabel}"/>
                        </Border>
                        <Border BackgroundColor="#2ECC71" Style="{StaticResource InformationBorderStyle}">
                            <Label Text="60 mins" Style="{StaticResource InformationLabel}"/>
                        </Border>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                        <Label Text="📅" FontSize="11" VerticalOptions="Center"/>
                        <Label Text="Preferred Day: Monday" TextColor="#333333" FontSize="11" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="›"
                       FontSize="32"
                       TextColor="#444444"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       Margin="10,0,0,0"/>
            </Grid>
        </Border>

    </VerticalStackLayout>
</ContentPage>